{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Id",
      "type": "string"
    },
    "modules_path": {
      "default": "modules",
      "minLength": 1,
      "title": "Modules Path",
      "type": "string"
    },
    "order": {
      "default": 0,
      "title": "Order",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "tags": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "title"
  ],
  "title": "CourseManifest",
  "type": "object"
}
