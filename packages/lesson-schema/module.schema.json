{
  "$defs": {
    "ControlOption": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "ControlOption",
      "type": "object"
    },
    "ControlSpec": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "default": null,
          "title": "Default"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/ControlOption"
          },
          "title": "Options",
          "type": "array"
        },
        "step": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "type": {
          "enum": [
            "slider",
            "number",
            "toggle",
            "select",
            "button",
            "segmented"
          ],
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "visible_when": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visible When"
        }
      },
      "required": [
        "id",
        "type",
        "label"
      ],
      "title": "ControlSpec",
      "type": "object"
    },
    "LessonBlock": {
      "additionalProperties": false,
      "properties": {
        "plot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plot"
        },
        "plots": {
          "items": {
            "type": "string"
          },
          "title": "Plots",
          "type": "array"
        },
        "props": {
          "additionalProperties": true,
          "title": "Props",
          "type": "object"
        },
        "reveal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reveal"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "tone": {
          "default": "info",
          "enum": [
            "info",
            "success",
            "warning",
            "danger"
          ],
          "title": "Tone",
          "type": "string"
        },
        "type": {
          "enum": [
            "markdown",
            "prediction",
            "controls",
            "metrics",
            "plot",
            "plot_grid",
            "table",
            "callout",
            "widget",
            "divider"
          ],
          "title": "Type",
          "type": "string"
        },
        "widget": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Widget"
        }
      },
      "required": [
        "type"
      ],
      "title": "LessonBlock",
      "type": "object"
    },
    "RuntimeSpec": {
      "additionalProperties": false,
      "properties": {
        "entrypoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entrypoint"
        },
        "kind": {
          "default": "static",
          "enum": [
            "python",
            "static"
          ],
          "title": "Kind",
          "type": "string"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        },
        "trust": {
          "const": "local-trusted",
          "default": "local-trusted",
          "title": "Trust",
          "type": "string"
        }
      },
      "title": "RuntimeSpec",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blocks": {
      "items": {
        "$ref": "#/$defs/LessonBlock"
      },
      "title": "Blocks",
      "type": "array"
    },
    "controls": {
      "items": {
        "$ref": "#/$defs/ControlSpec"
      },
      "title": "Controls",
      "type": "array"
    },
    "guiding_question": {
      "default": "",
      "title": "Guiding Question",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Id",
      "type": "string"
    },
    "number": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Number"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeSpec"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "implemented",
        "static"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title"
  ],
  "title": "ModuleManifest",
  "type": "object"
}
