{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tranquilworks.example/schemas/vehicle-dynamics-native-design-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "item_id",
    "module",
    "provenance",
    "governing_equations",
    "signature",
    "teaching_invariant",
    "limiting_cases",
    "scenarios",
    "independent_reference",
    "tolerance",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "item_id": {"type": "string", "pattern": "^P[0-9]{2}$"},
    "module": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_equivalence_claimed", "competency_map", "matlab_runtime"],
      "properties": {
        "kind": {"const": "python-first-native"},
        "source_equivalence_claimed": {"const": false},
        "competency_map": {"type": "string", "minLength": 1},
        "matlab_runtime": {"const": "not_run"}
      }
    },
    "governing_equations": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "signature": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "unit"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1}
        }
      }
    },
    "teaching_invariant": {"type": "string", "minLength": 20},
    "limiting_cases": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 10}
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "sweep_1", "sweep_2", "broken", "recovery"],
      "properties": {
        "baseline": {"type": "object"},
        "sweep_1": {"type": "object"},
        "sweep_2": {"type": "object"},
        "broken": {"type": "object"},
        "recovery": {"type": "object"}
      }
    },
    "independent_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "imports_production",
        "derived_from_production_output",
        "perturbs_production_output"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "imports_production": {"const": false},
        "derived_from_production_output": {"const": false},
        "perturbs_production_output": {"const": false}
      }
    },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolute", "relative"],
      "properties": {
        "absolute": {"type": "number", "exclusiveMinimum": 0},
        "relative": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 40}
  }
}
