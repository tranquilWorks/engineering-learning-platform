{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tranquilWorks/portfolio-control/contracts/course-competency-map.schema.json",
  "title": "Engineering course competency-to-module map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "course",
    "scope",
    "competencies",
    "modules",
    "assessments",
    "capstones",
    "evidence_plan",
    "batch_plan",
    "count_derivation"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "authority", "baseline"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "baseline": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_learners", "prerequisites", "outcomes", "exclusions", "cross_course_handoffs"],
      "properties": {
        "target_learners": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "prerequisites": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cross_course_handoffs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "competencies": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/competency"}
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/module"}
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assessment"}
    },
    "capstones": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capstone"}
    },
    "evidence_plan": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence_origin"}
    },
    "batch_plan": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/batch"}
    },
    "count_derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned_module_count", "source", "rationale"],
      "properties": {
        "planned_module_count": {"type": "integer", "minimum": 1},
        "source": {"const": "len(modules)"},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "competency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome", "prerequisite_ids", "module_ids", "assessment_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "outcome": {"type": "string", "minLength": 1},
        "prerequisite_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "module_ids": {"$ref": "#/$defs/ids"},
        "assessment_ids": {"$ref": "#/$defs/ids"}
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "competency_ids", "depends_on", "lesson_kind"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "competency_ids": {"$ref": "#/$defs/ids"},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "lesson_kind": {"enum": ["foundation", "concept", "laboratory", "integration", "capstone"]}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "competency_ids", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["formative", "cumulative", "capstone"]},
        "competency_ids": {"$ref": "#/$defs/ids"},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "capstone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "module_ids", "competency_ids", "integration_claim"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "module_ids": {"$ref": "#/$defs/ids"},
        "competency_ids": {"$ref": "#/$defs/ids"},
        "integration_claim": {"type": "string", "minLength": 1}
      }
    },
    "evidence_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "origin",
        "independent",
        "method",
        "tolerance",
        "imports_production_entrypoint",
        "derived_from_production_output",
        "perturbs_production_output"
      ],
      "properties": {
        "claim_id": {"$ref": "#/$defs/id"},
        "origin": {"enum": ["analytic", "closed_form", "invariant", "alternative_algorithm", "separately_formulated_numerical", "measured_fixture", "source_runtime"]},
        "independent": {"const": true},
        "method": {"type": "string", "minLength": 1},
        "tolerance": {"type": "string", "minLength": 1},
        "imports_production_entrypoint": {"const": false},
        "derived_from_production_output": {"const": false},
        "perturbs_production_output": {"const": false}
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "module_ids", "coherence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "module_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "coherence": {"type": "string", "minLength": 1}
      }
    }
  }
}
