{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-learning-platform.local/schemas/controls-gnc-fidelity-map-v1.json",
  "title": "Controls/GNC source-to-platform fidelity map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "course_id", "source", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "course_id": {"const": "controls-gnc"},
    "source": {"$ref": "#/$defs/source"},
    "items": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree", "curriculum"],
      "properties": {
        "repository": {"const": "tranquilWorks/controls-gnc-learning"},
        "commit": {"const": "ffd6623ee2cf8ccd8599fffd935ef07370750fa3"},
        "tree": {"const": "471a0afead6f44e875627e7ffe9c088c23f784db"},
        "curriculum": {"$ref": "#/$defs/file"}
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_control", "source_quantity", "unit", "role"],
      "properties": {
        "platform_control": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "source_quantity": {"$ref": "#/$defs/text"},
        "unit": {"$ref": "#/$defs/text"},
        "role": {"enum": ["learner_sweep", "failure_injection"]}
      }
    },
    "observable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity", "unit"],
      "properties": {
        "quantity": {"$ref": "#/$defs/text"},
        "unit": {"$ref": "#/$defs/text"}
      }
    },
    "sweep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "evidence_case", "endpoint", "one_variable", "expected_observation"],
      "properties": {
        "control": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "evidence_case": {"enum": ["sweep_1", "sweep_2"]},
        "endpoint": {"type": ["number", "integer", "string", "boolean"]},
        "one_variable": {"const": true},
        "expected_observation": {"$ref": "#/$defs/text"}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "state_change", "observable_failure"],
      "properties": {
        "trigger": {"const": "broken_mode=true"},
        "state_change": {"$ref": "#/$defs/text"},
        "observable_failure": {"$ref": "#/$defs/text"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "formulation", "path", "independent", "imports_production_entrypoint", "derived_from_production_output", "perturbs_production_output"],
      "properties": {
        "type": {"enum": ["closed_form", "alternative_algorithm", "separately_formulated_numerical"]},
        "formulation": {"$ref": "#/$defs/text"},
        "path": {"const": "reference_cases.py"},
        "independent": {"const": true},
        "imports_production_entrypoint": {"const": false},
        "derived_from_production_output": {"const": false},
        "perturbs_production_output": {"const": false}
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {"type": "string", "pattern": "^[xy][1-9]?$"},
        "title": {"$ref": "#/$defs/text"}
      }
    },
    "plot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "axes"],
      "properties": {
        "key": {"enum": ["response", "mechanism"]},
        "title": {"$ref": "#/$defs/text"},
        "axes": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/axis"}}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "source_folder", "target_folder", "source_model", "controls", "state_equations", "observables", "sweeps", "broken_case", "recovery", "teaching_invariant", "limiting_cases", "omissions", "reference", "plots"],
      "properties": {
        "id": {"type": "string", "pattern": "^P(?:0[1-9]|1[0-9]|2[0-4])$"},
        "number": {"type": "integer", "minimum": 1, "maximum": 24},
        "source_folder": {"$ref": "#/$defs/path"},
        "target_folder": {"$ref": "#/$defs/path"},
        "source_model": {"$ref": "#/$defs/file"},
        "controls": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/control"}},
        "state_equations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "observables": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/observable"}},
        "sweeps": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/sweep"}},
        "broken_case": {"$ref": "#/$defs/failure"},
        "recovery": {"$ref": "#/$defs/text"},
        "teaching_invariant": {"$ref": "#/$defs/text"},
        "limiting_cases": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/text"}},
        "omissions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "reference": {"$ref": "#/$defs/reference"},
        "plots": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/plot"}}
      }
    }
  }
}
